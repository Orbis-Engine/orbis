.DS_Store
.dart_tool/
.packages
build/
*.iml
.idea/
pubspec.lock
third_party/*.tgz
third_party/filament-*/

# spike build artefacts
spike/spike
spike/lit.filamat
spike/spike_output.png

# Built by packages/orbis_filament/darwin/setup.sh: the fetched SDK, the
# materials compiled out of it, and the one framework Swift Package Manager
# takes in place of the SDK's twenty archives.
packages/orbis_filament/darwin/third_party/
packages/orbis_filament/darwin/orbis_filament/third_party/
packages/orbis_filament/darwin/orbis_filament/Sources/orbis_filament_native/generated/

# Staged by packages/orbis_filament/windows/setup.sh: the Filament Windows
# release, either fetched here or symlinked from the project's own cache.
# The materials it compiles land in darwin/'s generated/ directory, which is
# already ignored above -- see that script for why the platforms share one.
packages/orbis_filament/windows/third_party/

# Flutter
.flutter-plugins-dependencies
**/windows/flutter/ephemeral/
# Written by the Flutter tool from the resolved plugin list on every build,
# exactly as macOS's GeneratedPluginRegistrant.swift below is, and ignored
# here for the same reason: it is output, and a machine that resolves a
# different set of plugins otherwise shows it as a change nobody made.
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake
**/macos/Pods/
**/macos/Podfile.lock
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.swift
*.iml

# Fetched by tool/fetch_bistro.sh: a CC BY 4.0 test scene, not ours to ship.
assets/bistro/

# Built by packages/orbis_filament/native/web/build.sh: object files, and the
# Emscripten module it links, served straight out of host/ alongside the
# static index.html/main.js that stay committed.
packages/orbis_filament/native/web/build/
packages/orbis_filament/native/web/host/orbis_renderer.js
packages/orbis_filament/native/web/host/orbis_renderer.wasm
packages/orbis_filament/native/web/captures/
