// Depth and nothing else: what the depth prepass draws every opaque surface
// with before any of them is shaded.
//
// The point of a prepass is that this is cheap and the real shading is not.
// So nothing is lit, nothing is sampled and no colour is written — the
// fragment does no work at all, and a GPU that shades what it is handed in
// the order it is handed it gets the nearest surface's depth for the price of
// rasterising, before the expensive surfaces arrive and find every pixel
// behind the nearest already answered.
//
// Culled at the back, like the surfaces it stands in for. It must never cover
// a pixel the real surface would not: depth written where nothing is then
// drawn hides whatever is behind, which is a hole. Covering less is only a
// smaller saving, so every doubt here is settled towards covering less.
material {
    name : orbisDepthOnly,
    shadingModel : unlit,
    colorWrite : false,
    depthWrite : true,
    culling : back
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(0.0);
    }
}
