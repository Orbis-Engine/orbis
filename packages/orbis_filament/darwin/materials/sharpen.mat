// Puts back the edge the anti-aliasing took off.
//
// Temporal anti-aliasing spreads a pixel's history over several frames, and
// the price of that is a softer picture: the sharpest a TAA image can be is
// slightly blurred. This is the usual answer — a small sharpen afterwards,
// contrast-adaptive so that how much it applies depends on how much local
// contrast is already there.
//
// Adaptive matters. A plain unsharp mask lifts detail and rings every high
// contrast edge it finds, which on a bright sky against a dark roof is a
// visible halo. Weighting by the local minimum and maximum gives flat regions
// almost nothing and busy regions most of it, so noise stays noise and an
// edge does not grow a bright rim.
material {
    name : orbisSharpen,
    // Unlit, because this is an image being read and written rather than a
    // surface: a shading model would light it.
    shadingModel : unlit,
    // Positions arrive already in clip space, so nothing transforms them. One
    // triangle big enough to cover the screen, drawn by the renderer.
    vertexDomain : device,
    requires : [ uv0 ],
    depthWrite : false,
    depthCulling : false,
    culling : none,
    parameters : [
        { type : sampler2d, name : source, precision : high },
        // Nought leaves the image alone; one is as far as this goes before it
        // starts looking like a filter rather than a lens.
        { type : float, name : amount }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 size = vec2(textureSize(materialParams_source, 0));
        vec2 step = 1.0 / size;
        vec2 at = getUV0();

        vec3 here  = texture(materialParams_source, at).rgb;
        vec3 up    = texture(materialParams_source, at + vec2(0.0, -step.y)).rgb;
        vec3 down  = texture(materialParams_source, at + vec2(0.0,  step.y)).rgb;
        vec3 left  = texture(materialParams_source, at + vec2(-step.x, 0.0)).rgb;
        vec3 right = texture(materialParams_source, at + vec2( step.x, 0.0)).rgb;

        // How much room there is to sharpen into, per channel. A pixel already
        // at the darkest or brightest of its neighbours has none, which is
        // what stops the halo.
        vec3 lowest  = min(here, min(min(up, down), min(left, right)));
        vec3 highest = max(here, max(max(up, down), max(left, right)));
        vec3 room = min(lowest, 1.0 - highest) / max(highest, vec3(1e-4));

        float strength = -0.125 * materialParams.amount;
        vec3 weight = sqrt(max(room, vec3(0.0))) * strength;
        vec3 sum = (up + down + left + right) * weight + here;
        vec3 total = 4.0 * weight + 1.0;

        material.baseColor = vec4(max(sum / total, vec3(0.0)), 1.0);
    }
}
