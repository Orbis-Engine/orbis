// Every pixel's motion, in pixels, as far as the shutter saw it.
//
// Two sources, merged. Anything that stood still moved only because the
// camera did, and that is rebuilt from depth: where the pixel is now, put back
// into the world, and projected by last frame's camera. Anything that moved
// on its own was drawn into the object velocity target by the velocity pass,
// and is taken from there — but only if the object is actually what this
// pixel shows, which is checked by distance, because that pass drew the
// moving things alone and a wall in front of one never reached it.
//
// What is written is McGuire et al.'s V: *half* the streak, since a point
// contributes to the pixels X ± V, clamped to the filter's reach. Scaled by
// how much of a frame the shutter was open for, which is the whole of the
// photographic part — the rest is geometry.
material {
    name : orbisMotionResolve,
    shadingModel : unlit,
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    requires : [ uv0 ],
    parameters : [
        // The scene's depth: reversed, infinite far, so near/distance.
        { type : sampler2d, name : depth, precision : high },
        // What the velocity pass drew: motion in texture units in RG, the
        // surface's distance in B, nought where nothing moving was drawn.
        { type : sampler2d, name : objects, precision : high },
        // Whether that target holds anything this frame.
        { type : float, name : useObjects },
        { type : float, name : near, precision : high },
        { type : float2, name : tangents },
        // Last frame's clip space from this frame's view space, so that one
        // multiply carries a pixel from here to where the camera saw it then.
        { type : mat4, name : reproject, precision : high },
        // The picture's size in pixels.
        { type : float2, name : size },
        // Shutter open time × frame rate: the part of a frame's travel the
        // picture records.
        { type : float, name : exposure },
        // Half the longest streak allowed, in pixels.
        { type : float, name : radius }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 uv = getUV0();
        ivec2 texel = ivec2(uv * materialParams.size);
        float d = texelFetch(materialParams_depth, texel, 0).r;

        // The pixel as a homogeneous point in view space. Written with the
        // reciprocal distance as w, so that d = 0 — the sky, infinitely far —
        // is a direction rather than a division by nought, and reprojects by
        // the camera's turn alone, which is exactly how the sky moves.
        vec2 ndc = vec2(2.0 * uv.x - 1.0, 1.0 - 2.0 * uv.y);
        vec4 here = vec4(ndc.x * materialParams.tangents.x,
                         ndc.y * materialParams.tangents.y,
                         -1.0,
                         d / materialParams.near);
        vec4 then = materialParams.reproject * here;

        vec2 moved = vec2(0.0);
        if (then.w > 1e-6) {
            moved = (ndc - then.xy / then.w) * vec2(0.5, -0.5);
        }

        // Taken from the object instead where the object is what is seen.
        // A relative tolerance, since a depth buffer's precision falls off
        // with distance and the velocity target is half floats.
        float distance = d > 0.0 ? materialParams.near / d : 1.0e5;
        if (materialParams.useObjects > 0.5) {
            vec4 object = texelFetch(materialParams_objects, texel, 0);
            if (object.b > 0.0 &&
                abs(object.b - distance) < 0.02 * distance + 0.02) {
                moved = object.rg;
            }
        }

        // Half the streak, in pixels, clamped to the reach.
        vec2 v = moved * materialParams.size * materialParams.exposure * 0.5;
        float length = sqrt(dot(v, v));
        if (length > materialParams.radius) {
            v *= materialParams.radius / length;
        }

        material.baseColor = vec4(v, distance, 1.0);
    }
}
