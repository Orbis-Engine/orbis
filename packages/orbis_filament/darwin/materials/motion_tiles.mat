// The largest motion in each tile of the screen.
//
// McGuire, Hennessy, Bukowski and Osman (2012), equation 1: the vector of
// greatest magnitude over a k × k tile — the vector, not a per-component
// maximum, which would invent a diagonal motion out of two straight ones.
// Tiles are as wide as the longest half-streak, so the tile a pixel is in and
// its eight neighbours cover every pixel whose streak could reach it. The
// neighbour step (equation 2) is folded into the gather, which reads those
// nine tiles itself rather than paying for another target.
material {
    name : orbisMotionTiles,
    shadingModel : unlit,
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    requires : [ uv0 ],
    parameters : [
        { type : sampler2d, name : velocity, precision : high },
        // k, the tile's side in pixels.
        { type : int, name : tile },
        // The tiles' own grid, and the full picture's size.
        { type : float2, name : tiles },
        { type : float2, name : size }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        ivec2 which = ivec2(getUV0() * materialParams.tiles);
        int k = materialParams.tile;
        ivec2 from = which * k;
        ivec2 last = ivec2(materialParams.size) - 1;

        vec2 largest = vec2(0.0);
        float most = 0.0;
        // Bounded loops, because not every backend accepts a loop whose trip
        // count is a uniform; the renderer holds k to 32.
        for (int y = 0; y < 32; y++) {
            if (y >= k) break;
            for (int x = 0; x < 32; x++) {
                if (x >= k) break;
                ivec2 at = min(from + ivec2(x, y), last);
                vec2 v = texelFetch(materialParams_velocity, at, 0).rg;
                float m = dot(v, v);
                if (m > most) {
                    most = m;
                    largest = v;
                }
            }
        }
        material.baseColor = vec4(largest, 0.0, 1.0);
    }
}
