// SMAA, pass two of three: how much of each pixel does the edge cover?
//
// The pass that does the real work, and the one the technique is named for.
// Pass one said *where* the edges are. This one walks along each edge to find
// out what shape it belongs to — how far it runs left and right, what it does
// at each end — and looks that shape up in a table of precomputed coverage.
// The answer is how much of this pixel the far side of the edge occupies,
// which is exactly the weight needed to blend it.
//
// The lookup is what keeps this cheap. Working the coverage out per pixel is
// integration over a shape; reading it out of a texture indexed by the
// distances and the end conditions is one fetch.
//
// Adapted from the reference implementation, MIT licensed:
//   Copyright (C) 2013 Jorge Jimenez, Jose I. Echevarria, Belen Masia,
//   Fernando Navarro and Diego Gutierrez. See LICENSES/SMAA.txt.
material {
    name : orbisSmaaWeights,
    shadingModel : unlit,
    vertexDomain : device,
    requires : [ uv0 ],
    depthWrite : false,
    depthCulling : false,
    culling : none,
    parameters : [
        // What pass one wrote.
        { type : sampler2d, name : edges, precision : high },
        // The coverage table, and the table that says how far a search ran.
        { type : sampler2d, name : area, precision : high },
        { type : sampler2d, name : search, precision : high },
        { type : float2, name : step },
        // How far along an edge to look before giving up. Longer catches
        // shallower diagonals and costs more; the reference default is
        // sixteen.
        { type : float, name : reach }
    ]
}

fragment {
    #define kAreaWide      160.0
    #define kAreaTall      560.0
    // Each of the table's cells covers this many steps of distance.
    #define kAreaCell       16.0
    #define kAreaMaxCell     7.0
    // The logical grid the table stands for, and the texels it is stored in.
    #define kSearchWide      66.0
    #define kSearchTall      33.0
    #define kSearchPacked    64.0
    #define kSearchPackedTall 16.0

    vec2 areaStep() { return vec2(1.0 / kAreaWide, 1.0 / kAreaTall); }

    // How far the edge above this point runs, read out of the search table.
    //
    // A table rather than a loop: the answer depends only on the pattern of
    // edges found at the two ends, and there are few enough patterns to have
    // written every answer down.
    float searchLength(vec2 e, float offset) {
        // The table is sixty-four by sixteen texels and stands for a grid of
        // sixty-six by thirty-three. Both numbers are needed and they are not
        // interchangeable: the grid sets the scale and the bias, and the
        // texels are what those are then measured in. Dividing the *result*
        // by the grid instead of dividing scale and bias by the texels lands
        // a little way off every entry, which reads back as almost no weight
        // anywhere and an SMAA that runs and does nothing.
        vec2 scale = vec2(kSearchWide, kSearchTall) * vec2(0.5, -1.0);
        vec2 bias  = vec2(kSearchWide, kSearchTall) * vec2(offset, 1.0);
        scale += vec2(-1.0,  1.0);
        bias  += vec2( 0.5, -0.5);
        vec2 packed = vec2(1.0 / kSearchPacked, 1.0 / kSearchPackedTall);
        scale *= packed;
        bias *= packed;
        return textureLod(materialParams_search, scale * e + bias, 0.0).r;
    }

    float searchLeft(vec2 at, float end) {
        vec2 px = materialParams.step;
        vec2 e = vec2(0.0, 1.0);
        vec2 walk = at;
        for (float i = 0.0; i < 16.0; i += 1.0) {
            if (i >= materialParams.reach) break;
            e = textureLod(materialParams_edges, walk, 0.0).rg;
            // Stop where the edge above stops, or where a crossing edge
            // begins: either is the end of this shape.
            if (e.g < 0.8281 || e.r > 0.0) break;
            walk -= vec2(px.x * 2.0, 0.0);
        }
        float offset = -(255.0 / 127.0) * searchLength(e, 0.0) + 3.25;
        return px.x * offset + walk.x;
    }

    float searchRight(vec2 at, float end) {
        vec2 px = materialParams.step;
        vec2 e = vec2(0.0, 1.0);
        vec2 walk = at;
        for (float i = 0.0; i < 16.0; i += 1.0) {
            if (i >= materialParams.reach) break;
            e = textureLod(materialParams_edges, walk, 0.0).rg;
            if (e.g < 0.8281 || e.r > 0.0) break;
            walk += vec2(px.x * 2.0, 0.0);
        }
        float offset = -(255.0 / 127.0) * searchLength(e, 0.5) + 3.25;
        return -px.x * offset + walk.x;
    }

    float searchUp(vec2 at, float end) {
        vec2 px = materialParams.step;
        vec2 e = vec2(1.0, 0.0);
        vec2 walk = at;
        for (float i = 0.0; i < 16.0; i += 1.0) {
            if (i >= materialParams.reach) break;
            e = textureLod(materialParams_edges, walk, 0.0).rg;
            if (e.r < 0.8281 || e.g > 0.0) break;
            walk -= vec2(0.0, px.y * 2.0);
        }
        float offset = -(255.0 / 127.0) * searchLength(e.gr, 0.0) + 3.25;
        return px.y * offset + walk.y;
    }

    float searchDown(vec2 at, float end) {
        vec2 px = materialParams.step;
        vec2 e = vec2(1.0, 0.0);
        vec2 walk = at;
        for (float i = 0.0; i < 16.0; i += 1.0) {
            if (i >= materialParams.reach) break;
            e = textureLod(materialParams_edges, walk, 0.0).rg;
            if (e.r < 0.8281 || e.g > 0.0) break;
            walk += vec2(0.0, px.y * 2.0);
        }
        float offset = -(255.0 / 127.0) * searchLength(e.gr, 0.5) + 3.25;
        return -px.y * offset + walk.y;
    }

    // The coverage table, indexed by how far the edge ran each way and by what
    // it did at the ends.
    vec2 area(vec2 distance, float ends1, float ends2) {
        vec2 at = kAreaCell * round(4.0 * vec2(ends1, ends2)) + distance;
        at = areaStep() * at + 0.5 * areaStep();
        return textureLod(materialParams_area, at, 0.0).rg;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 at = getUV0();
        vec2 px = materialParams.step;
        vec4 weights = vec4(0.0);
        vec2 e = texture(materialParams_edges, at).rg;

        // Green: an edge along the top of this pixel, so the shape runs
        // left and right.
        if (e.g > 0.0) {
            vec2 leftAt  = vec2(searchLeft(at - vec2(px.x * 0.25, 0.0), 0.0), at.y);
            vec2 rightAt = vec2(searchRight(at + vec2(px.x * 1.25, 0.0), 0.0), at.y);

            // How far the shape ran each way, in pixels.
            vec2 ran = vec2(at.x - leftAt.x, rightAt.x - at.x) / px.x;

            // What the edge does where it stopped: turning up, turning down,
            // or simply ending. That is what makes a step a step and a
            // diagonal a diagonal.
            float endLeft  = textureLod(materialParams_edges,
                                        vec2(leftAt.x, at.y - px.y), 0.0).r;
            float endRight = textureLod(materialParams_edges,
                                        vec2(rightAt.x + px.x, at.y - px.y), 0.0).r;

            weights.rg = area(sqrt(abs(ran)), endLeft, endRight);
        }

        // Red: an edge down the left of this pixel, so the shape runs up and
        // down. The same walk, turned ninety degrees.
        if (e.r > 0.0) {
            vec2 upAt   = vec2(at.x, searchUp(at - vec2(0.0, px.y * 0.25), 0.0));
            vec2 downAt = vec2(at.x, searchDown(at + vec2(0.0, px.y * 1.25), 0.0));

            vec2 ran = vec2(at.y - upAt.y, downAt.y - at.y) / px.y;

            float endUp   = textureLod(materialParams_edges,
                                       vec2(at.x - px.x, upAt.y), 0.0).g;
            float endDown = textureLod(materialParams_edges,
                                       vec2(at.x - px.x, downAt.y + px.y), 0.0).g;

            weights.ba = area(sqrt(abs(ran)), endUp, endDown);
        }

        material.baseColor = weights;
    }
}
