// The standard surface.
//
// Everything an object's look is made of, in one shader: a base colour that
// can come from a texture, metalness and roughness that can come from a
// packed map, a normal map, an occlusion map and an emissive map — plus one
// UV transform applied to all of them.
//
// One shader rather than a family of them, with a `has*` flag per map. The
// flags are uniforms, so every fragment in a draw takes the same branch and
// the GPU pays for a scalar test, not a divergence. The alternative — a
// compiled variant per combination of maps — is thirty-two shaders to reach
// the same pixels.
//
// `blending` is the exception that cannot be a uniform: it is fixed function
// state baked into the compiled material. setup.sh generates one copy of this
// file per blend mode, which is why the line below is written plainly enough
// to substitute.
material {
    name : orbisLit,
    shadingModel : lit,
    // The third, for one reason: a material may have nine samplers below it
    // however capable the hardware is, and the standard surface needs ten.
    // The engine asks for the highest the device supports and clamps, so a
    // device that cannot manage this compiles the other surfaces and leaves
    // this one out rather than failing to start.
    featureLevel : 3,
    blending : opaque,
    // Both the area lights and the irradiance field are handed back this
    // way, and added rather than mixed: what they carry arrives alongside
    // Filament's own lighting, not instead of it.
    postLightingBlending : add,
    doubleSided : true,

    // Roughness is a statement about detail too small to see. A normal map
    // carries exactly that detail, and once it falls below a pixel the
    // shading frame changes faster than the frame can sample it — which
    // reads as glitter crawling over a surface as the camera moves, worst at
    // grazing angles and on anything shiny. The fix is not to blur the map:
    // it is to widen the distribution by however much the normal varies
    // inside the pixel, so sub-pixel bumps become roughness, which is what
    // roughness was always for. Variance is how much of the screen-space
    // derivative to believe; the threshold caps how rough it may claim a
    // surface is, so a mirror stays a mirror.
    specularAntiAliasing : true,
    specularAntiAliasingVariance : 0.15,
    specularAntiAliasingThreshold : 0.2,

    // Occlusion darkens, and a single application of it darkens too much.
    // Light that a crease blocks does not vanish; it bounces inside the
    // crease and some of it leaves. Applying the occlusion term once treats
    // every blocked photon as absorbed, which is why heavily occluded
    // surfaces go muddy and lose their colour. This puts the later bounces
    // back, tinted by the surface's own albedo — so a red crease stays red
    // rather than going grey.
    multiBounceAmbientOcclusion : true,

    // The same argument for the specular half, which is otherwise not
    // occluded at all: a mirror at the bottom of a crevice reflects the
    // whole environment, because ambient occlusion by default only touches
    // the diffuse term. `simple` derives a specular occlusion from the
    // diffuse one and the roughness, which is cheap and stops the shine
    // that has no business being there.
    specularAmbientOcclusion : simple,

    requires : [ uv0 ],
    parameters : [
        { type : float4,    name : baseColor },
        { type : float,     name : metallic },
        { type : float,     name : roughness },
        { type : float,     name : reflectance },
        { type : float3,    name : emissive },
        { type : float,     name : emissiveIntensity },
        { type : float,     name : ambientOcclusion },
        { type : float,     name : normalScale },

        // Tiling in xy, offset in zw. Filament has no automatic equivalent —
        // a texture repeats only because the shader multiplies here.
        { type : float4,    name : uvTransform },

        // A second specular lobe over the first: varnish, lacquer, car paint,
        // a wet surface. It is not the same as lowering roughness, and the
        // difference is the reason it exists — the coat has its own Fresnel
        // and its own roughness, so a rough red panel under gloss keeps its
        // rough red diffuse and gains a sharp white highlight on top, which
        // no single lobe can do at once.
        { type : float,     name : clearCoat },
        { type : float,     name : clearCoatRoughness },

        // Stretches the highlight along the surface's tangent. Brushed metal,
        // hair, a vinyl record, the bottom of a saucepan: all surfaces whose
        // microscopic grooves run one way, so the reflection smears across
        // the grain rather than pooling. Negative runs the other way.
        { type : float,     name : anisotropy },

        // Retroreflection at grazing angles, which is what makes cloth read
        // as cloth. Velvet, felt and brushed wool are brighter at their
        // silhouette than face-on — the opposite of everything the standard
        // lobe does, and unreachable by any amount of roughness.
        { type : float3,    name : sheenColor },
        { type : float,     name : sheenRoughness },

        // Wind. xy the direction it blows along the ground, z how fast in
        // metres per second, w how much this surface answers it — nought for
        // anything rigid, which is almost everything.
        //
        // On the material rather than on the scene, and that is a design
        // decision worth defending. Wind is a property of the world, so the
        // obvious home is the scene — but then every surface answers it
        // identically, and a wall would sway. Put it here and a material
        // states its own compliance: the trunk barely moves, the canopy
        // moves a lot, the rock does not move at all. It costs nothing to
        // restate every frame because the scene is restated every frame
        // anyway.
        { type : float4,    name : wind },

        { type : sampler2d, name : baseColorMap },
        { type : sampler2d, name : normalMap },
        { type : sampler2d, name : metallicRoughnessMap },
        { type : sampler2d, name : occlusionMap },
        { type : sampler2d, name : emissiveMap },

        { type : bool,      name : hasBaseColorMap },
        { type : bool,      name : hasNormalMap },
        { type : bool,      name : hasMetallicRoughnessMap },
        { type : bool,      name : hasOcclusionMap },
        { type : bool,      name : hasEmissiveMap },

        // A second surface, mixed into the first.
        //
        // What this is for is ground: grass over rock, cobbles over mud, a
        // path worn through a field. Two materials on one mesh, because the
        // alternative is either a seam where two meshes meet or a texture
        // painted for that one patch of world and useful nowhere else.
        //
        // Off by default and free when off — blendMode zero skips every
        // sample below, and a uniform branch costs a scalar test rather than
        // a divergence.
        { type : sampler2d, name : blendBaseColorMap },
        { type : sampler2d, name : blendMaskMap },
        { type : bool,      name : hasBlendBaseColorMap },
        { type : bool,      name : hasBlendMaskMap },

        // 0 none, 1 linear, 2 masked, 3 masked depth.
        { type : int,       name : blendMode },
        { type : float,     name : blendAmount },
        { type : float,     name : blendSharpness },
        // The second layer tiles on its own: rock at one scale under grass
        // at another is most of what stops tiling from reading as tiling.
        { type : float4,    name : blendUvTransform },

        // Rectangular area lights, which Filament does not have.
        //
        // Filament shades points and cones. A rectangle is neither, so it is
        // shaded here instead and added to what Filament worked out, through
        // postLightingColor. That is the whole reason this lives in a
        // material rather than in the engine — and why it needs no fork.
        //
        // The lights arrive as a texture rather than as a uniform array
        // because the count changes per frame and a uniform array does not:
        // an array sized for the worst case is paid for on every draw that
        // has no area light at all, and a texture is paid for by the lights
        // that exist. Four texels each: position and count, colour, the
        // width edge, the height edge.
        // How many there are rides in the texture too — the first light's
        // spare channel — rather than in a uniform beside it. A uniform would
        // have to be pushed to every surface in the scene on the frame a
        // light is switched on, and a surface that missed the push would be
        // lit by a stale count. This cannot go out of step with the data
        // because it *is* the data.
        // One texture for both, and not for tidiness: a material at
        // Filament's first feature level may have nine samplers, and the
        // area lights, the fitted tables and the irradiance field together
        // are the tenth. These two share because they can — the tables are
        // read with filtering and the lights with texelFetch, which ignores
        // filtering entirely, so one sampler serves both without either
        // getting the other's.

        // The fitted tables. Two 64x64 tiles side by side in one texture:
        // the inverse transform at u in [0, 0.5), the shadowing and Fresnel
        // pair at u in [0.5, 1). One sampler rather than two, because
        // samplers are the scarce thing in a material and tiles are free.
        { type : sampler2d, name : lightData, precision : high },

        // The world-space irradiance field, if the scene has one.
        //
        // Read here rather than composited over the finished picture, because
        // indirect light is light: it has to be reflected by this surface's
        // own colour and roughness like any other, and a pass over the frame
        // has neither.
        { type : sampler2d, name : fieldAtlas, precision : high },
        // xyz the corner probe's position, w whether the field is on.
        { type : float4,    name : fieldOrigin },
        // xyz metres between probes, w how much of it reaches surfaces.
        { type : float4,    name : fieldSpacing },
        // xyz how many probes, w how many tiles fit across the atlas.
        { type : float4,    name : fieldCounts },
        // xy one texel of the atlas, z the normal bias as a fraction of a
        // cell, w spare.
        { type : float4,    name : fieldAtlasStep }
    ],
}

vertex {
    // ---- Wind ----
    //
    // A tree is a hierarchy of rigid segments hinged at their joints, and the
    // honest way to move one is to rotate each segment about its parent and
    // let the rotations compose. That needs per-vertex branch indices,
    // weights and stiffness baked into the mesh — which is exactly what an
    // exporter does not write and `gltfio` does not carry. So this takes the
    // approximation that the same literature uses when the authoring is not
    // there: height above the object's own origin stands in for how far down
    // the hierarchy a vertex sits, because in a tree those are very nearly
    // the same number.
    //
    // What survives from the real model is the part that matters — the
    // decomposition into frequency bands. A trunk answers a gust slowly and
    // springs back past centre; a branch answers faster; a leaf flutters at a
    // rate that has nothing to do with either. One sine cannot be all three,
    // and the give-away that something is procedural is almost always that
    // it is.
    //
    // Riccio and Ourselin, "GPU-Generated Procedural Wind Animations for
    // Trees", GPU Gems 3, chapter 6.

    void materialVertex(inout MaterialVertexInputs material) {
        float strength = materialParams.wind.w;
        if (strength <= 0.0) return;

        vec2 direction = materialParams.wind.xy;
        float speed = materialParams.wind.z;
        if (speed <= 0.0) return;

        // Where this instance stands. Taken from its transform rather than
        // from a vertex attribute, so a forest of ten thousand copies of one
        // mesh gets ten thousand different phases without carrying a single
        // extra byte per vertex — and the same tree is in the same part of
        // its cycle every time the scene is drawn, because its position is
        // not going to change.
        mat4 model = getWorldFromModelMatrix();
        vec3 anchor = vec3(model[3][0], model[3][1], model[3][2]);
        float phase = anchor.x * 0.73 + anchor.z * 1.31;

        // The object's own up, in the object's own space, so a vertex knows
        // how far it is from the ground it is rooted in rather than from the
        // world's zero.
        float height = max(material.worldPosition.y - anchor.y, 0.0);

        // Quadratic, not linear: a trunk is clamped at the base, so the
        // displacement of a cantilever grows with the square of the distance
        // from where it is held. Linear would slide the whole tree sideways,
        // roots included.
        float lever = height * height * strength;

        float t = getUserTime().x * speed;

        // Three bands. The first is the gust the tree leans into, the second
        // is the elastic recovery overshooting past centre — which is what
        // makes it read as springy rather than as blown — and the third is
        // the small chaotic motion of everything at the ends.
        float lean = sin(t * 0.55 + phase) * 0.60;
        float recoil = sin(t * 1.30 + phase * 1.7) * 0.25;
        float chatter = sin(t * 3.10 + phase * 2.9
                            + material.worldPosition.x * 1.7) * 0.10;

        // Flutter is per-vertex rather than per-instance, and deliberately
        // not scaled by the lever: a leaf at the end of a still branch still
        // moves, and tying it to the bend would freeze the canopy every time
        // the gust passed through zero.
        float flutter = sin(t * 6.7
                            + material.worldPosition.x * 3.1
                            + material.worldPosition.z * 2.7) * 0.04 * strength;

        float bend = lever * (lean + recoil + chatter) * 0.05 * speed;

        material.worldPosition.xz += direction * (bend + flutter * height);
        // Dropped by roughly the distance it moved sideways, because a branch
        // pivots about its joint rather than stretching: without this a tree
        // in a strong wind grows visibly taller.
        material.worldPosition.y -= abs(bend) * 0.25;
    }
}

fragment {
    // ---- Rectangular area lights ----
    //
    // Filament shades points and cones, so a rectangle is shaded here and
    // handed back through postLightingColor. The maths is linearly
    // transformed cosines: for each roughness and viewing angle a fitted
    // matrix turns the clamped cosine lobe into the GGX lobe, so integrating
    // the rectangle against the *cosine* — which has a closed form — answers
    // for the rectangle against GGX, which does not. One polygon integral
    // per light, no marching, no sampling.
    //
    // Heitz, Dupuy, Hill and Neubelt, "Real-Time Polygonal-Light Shading with
    // Linearly Transformed Cosines", ACM TOG (Proc. SIGGRAPH 2016) 35(4).
    // See LICENSES/LTC.txt. Tables fetched by setup.sh.

    // Each fitted table is 64 square, and the two sit side by side in one
    // texture. The half-texel inset is not decoration: without it the
    // bilinear footprint at the right-hand edge of the first tile reaches
    // into the second, and a roughness of one would read the Fresnel table
    // as if it were a matrix.
    // The two fitted tiles occupy the first 64 rows; the rectangles' own
    // numbers sit in the rows below them.
    #define kLtcRows 64.0
    #define kDataRows 80.0

    vec4 ltcTable(vec2 uv, float tile) {
        vec2 t = uv * (63.0 / 64.0) + 0.5 / 64.0;
        return textureLod(materialParams_lightData,
                          vec2((t.x + tile) * 0.5,
                               t.y * (kLtcRows / kDataRows)), 0.0);
    }

    // The integral along one edge of the polygon, as a vector so the four
    // edges can be summed before the form factor is taken. The rational
    // fit stands in for acos(x)/sqrt(1-x*x), which is the expensive part.
    vec3 ltcEdge(vec3 a, vec3 b) {
        float x = dot(a, b);
        float y = abs(x);
        float p = 0.8543985 + (0.4965155 + 0.0145206 * y) * y;
        float q = 3.4175940 + (4.1616724 + y) * y;
        float v = p / q;
        float thetaSinTheta = x > 0.0
            ? v
            : 0.5 * inversesqrt(max(1.0 - x * x, 1e-7)) - v;
        return cross(a, b) * thetaSinTheta;
    }

    // How much of the cosine lobe the rectangle covers, once `invM` has bent
    // that lobe into the shape of the surface's own.
    //
    // The horizon is dealt with by the table rather than by clipping the
    // polygon against it. Clipping means a variable-length vertex list and a
    // branch per edge; the table is one fetch. It is also more faithful than
    // the closed form that is often used in its place — measured against
    // this same table, that approximation is out by up to 0.18 absolute
    // around the horizon, which is a visible over-brightening exactly where
    // a panel grazes a surface.
    float ltcIntegrate(vec3 n, vec3 v, vec3 p, mat3 invM,
                       vec3 c0, vec3 c1, vec3 c2, vec3 c3) {
        vec3 t1 = normalize(v - n * dot(v, n));
        vec3 t2 = cross(n, t1);
        mat3 toCosine = invM * transpose(mat3(t1, t2, n));

        vec3 l0 = normalize(toCosine * (c0 - p));
        vec3 l1 = normalize(toCosine * (c1 - p));
        vec3 l2 = normalize(toCosine * (c2 - p));
        vec3 l3 = normalize(toCosine * (c3 - p));

        vec3 sum = ltcEdge(l0, l1) + ltcEdge(l1, l2)
                 + ltcEdge(l2, l3) + ltcEdge(l3, l0);

        float len = length(sum);
        if (len < 1e-6) return 0.0;

        // Which side of the panel the surface is on decides the sign of the
        // form factor, and a one-sided panel throws the far side away.
        vec3 lightNormal = cross(c1 - c0, c3 - c0);
        float z = sum.z / len;
        if (dot(c0 - p, lightNormal) < 0.0) return 0.0;

        return len * ltcTable(vec2(z * 0.5 + 0.5, len), 1.0).w;
    }

    // Everything the rectangles add at this fragment, in the same photometric
    // units Filament's own lights work in.
    vec3 areaLighting(const MaterialInputs material,
                      float metallic, float roughness) {
        // One fetch to find out there is nothing to do, which is the usual
        // answer and the one that has to be cheap.
        int count = int(texelFetch(materialParams_lightData, ivec2(0, int(kLtcRows)), 0).w);
        if (count <= 0) return vec3(0.0);

        // Filament shifts the world origin to the camera for precision, so a
        // shading position is camera-relative while a light arrives in the
        // coordinates the scene was authored in. `getUserWorldPosition` undoes
        // the shift. Directions are left alone: the shift is a translation —
        // Filament's own `getWorldOffset` is just this matrix's last column —
        // and a translation does not turn a vector.
        vec3 p = getUserWorldPosition();
        vec3 n = getWorldNormalVector();
        vec3 v = getWorldViewVector();

        float nDotV = clamp(dot(n, v), 0.0, 1.0);
        vec2 lut = vec2(roughness, sqrt(1.0 - nDotV));
        vec4 t1 = ltcTable(lut, 0.0);
        vec4 t2 = ltcTable(lut, 1.0);

        // The fitted inverse is sparse; these four are the only entries that
        // are neither zero nor one, and the table stores it normalised so the
        // middle is one.
        mat3 invM = mat3(vec3(t1.x, 0.0, t1.y),
                         vec3(0.0, 1.0, 0.0),
                         vec3(t1.z, 0.0, t1.w));

        vec3 diffuseColour = material.baseColor.rgb * (1.0 - metallic);
        // The dielectric floor is Filament's own: 4% of the light reflects off
        // any smooth surface, and a metal reflects its own colour instead.
        vec3 f0 = mix(vec3(0.04), material.baseColor.rgb, metallic);
        vec3 fresnel = f0 * t2.x + (1.0 - f0) * t2.y;

        vec3 total = vec3(0.0);
        for (int i = 0; i < count; i++) {
            vec4 a0 = texelFetch(materialParams_lightData, ivec2(0, int(kLtcRows) + i), 0);
            vec4 a1 = texelFetch(materialParams_lightData, ivec2(1, int(kLtcRows) + i), 0);
            vec4 a2 = texelFetch(materialParams_lightData, ivec2(2, int(kLtcRows) + i), 0);
            vec4 a3 = texelFetch(materialParams_lightData, ivec2(3, int(kLtcRows) + i), 0);

            vec3 centre = a0.xyz;
            vec3 radiance = a1.rgb;
            vec3 right = a2.xyz * (a2.w * 0.5);
            vec3 up = a3.xyz * (a3.w * 0.5);

            vec3 c0 = centre - right - up;
            vec3 c1 = centre + right - up;
            vec3 c2 = centre + right + up;
            vec3 c3 = centre - right + up;

            // The polygon integral already carries the inverse square, so the
            // only distance term here is the window that lets a light be
            // switched off past a radius rather than followed forever.
            vec3 toCentre = centre - p;
            float factor = dot(toCentre, toCentre) * a1.w * a1.w;
            float window = clamp(1.0 - factor * factor, 0.0, 1.0);
            window *= window;
            if (window <= 0.0) continue;

            float specular = ltcIntegrate(n, v, p, invM, c0, c1, c2, c3);
            float diffuse = ltcIntegrate(n, v, p, mat3(1.0), c0, c1, c2, c3);

            total += radiance * window
                   * (fresnel * specular + diffuseColour * diffuse);
        }

        // Filament pre-exposes light before it reaches the shader, and
        // postLightingColor is added after that has happened, so this has to
        // apply the exposure itself. Without it a panel is correct at EV 0
        // and blows out the moment the camera is stopped down.
        return total * getExposure();
    }

    // ---- The world-space irradiance field ----
    //
    // Eight probes stand at the corners of the cell containing this point.
    // Each is asked what light it has stored in the direction this surface
    // faces, and the answers are mixed by how close each probe is, by whether
    // the surface faces it at all, and by whether it can see this point.
    //
    // The taps are written out rather than looped. It costs nothing and it
    // keeps the shader free of a dynamic loop over texture reads, which is
    // the shape that translates worst.

    #define kFieldTile 8.0
    #define kFieldInterior 6.0

    vec2 fieldOctSign(vec2 v) {
        return vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
    }

    vec2 fieldOctEncode(vec3 dir) {
        vec3 n = dir / (abs(dir.x) + abs(dir.y) + abs(dir.z));
        vec2 e = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * fieldOctSign(n.xy);
        return e * 0.5 + 0.5;
    }

    // Where in the atlas a probe keeps the light it has from one direction.
    vec2 fieldAtlasUv(float index, vec3 direction) {
        float perRow = materialParams.fieldCounts.w;
        float row = floor(index / perRow);
        vec2 tileOrigin = vec2((index - row * perRow) * kFieldTile,
                               row * kFieldTile);
        vec2 oct = clamp(fieldOctEncode(direction), 0.0, 1.0);
        vec2 texel = tileOrigin + vec2(1.0) + oct * kFieldInterior;
        // Half a texel inside the interior, so the bilinear footprint reaches
        // the gutter — which mirrors this tile — rather than the next probe's
        // tile, which is a different place in the room.
        texel = clamp(texel, tileOrigin + vec2(0.5),
                      tileOrigin + vec2(kFieldInterior + 1.5));
        return texel * materialParams.fieldAtlasStep.xy;
    }

    // One corner of the cage, premultiplied by its weight, with the weight in
    // alpha. A probe outside the lattice falls out as a zero rather than as a
    // branch.
    // `lookup` is the direction the light is wanted from and `normal` is the
    // way the surface faces. For diffuse they are the same vector; for a
    // reflection they are not, and keeping them apart is the whole reason
    // this takes two — the octahedral fetch follows the reflection, while
    // which probes are trusted still follows the surface.
    vec4 fieldTap(vec3 corner, vec3 base, vec3 alpha, vec3 at, vec3 lookup,
                  vec3 normal) {
        vec3 counts = materialParams.fieldCounts.xyz;
        vec3 slot = base + corner;
        float inside = (any(lessThan(slot, vec3(0.0))) ||
                        any(greaterThan(slot, counts - vec3(1.0))))
            ? 0.0 : 1.0;

        // How much of this cell this corner owns, floored so that a point
        // whose whole cage sits to one side still has something to divide by.
        vec3 trilinear = max(mix(vec3(1.0) - alpha, alpha, corner), vec3(0.001));
        float weight = trilinear.x * trilinear.y * trilinear.z;

        vec3 probe = materialParams.fieldOrigin.xyz
                   + slot * materialParams.fieldSpacing.xyz;
        vec3 toProbe = probe - at;
        float away = length(toProbe);
        vec3 towards = away > 1e-5 ? toProbe / away : normal;

        // A probe behind the surface sees a different room, so it fades out
        // rather than being cut off. The floor is load-bearing: without it a
        // surface whose whole cage is behind it has nothing left and goes
        // black.
        weight *= pow(max(dot(towards, normal), 0.0) * 0.5 + 0.5, 2.0) + 0.2;

        float index = slot.x + counts.x * (slot.y + counts.y * slot.z);
        vec4 held = textureLod(materialParams_fieldAtlas,
                               fieldAtlasUv(index, lookup), 0.0);

        // What the probe stored as the distance to the nearest thing in this
        // direction. Further away than that and the probe is on the other
        // side of something from this point, so what it holds is a different
        // room's light. This is what stops a field lighting the inside of a
        // wall with the sunshine outside it.
        float reach = held.a;
        if (reach > 0.0 && away > reach + length(materialParams.fieldSpacing.xyz) * 0.5) {
            weight *= 0.05;
        }

        weight = max(weight, 1e-6) * inside;
        return vec4(max(held.rgb, vec3(0.0)) * weight, weight);
    }

    // The light the field holds where this surface is, arriving from
    // `lookup`. Nought when there is no field.
    vec3 fieldArriving(vec3 lookup) {
        vec3 normal = getWorldNormalVector();
        vec3 spacing = materialParams.fieldSpacing.xyz;
        // Pushed off the surface along its own normal, or a surface finds
        // itself in the probes around it and lights itself — which reads as a
        // glow along every wall.
        vec3 at = getUserWorldPosition()
                + normal * (materialParams.fieldAtlasStep.z
                            * min(spacing.x, min(spacing.y, spacing.z)));

        vec3 lattice = (at - materialParams.fieldOrigin.xyz) / spacing;
        vec3 base = floor(lattice);
        vec3 alpha = clamp(lattice - base, 0.0, 1.0);

        vec4 total =
            fieldTap(vec3(0.0, 0.0, 0.0), base, alpha, at, lookup, normal) +
            fieldTap(vec3(1.0, 0.0, 0.0), base, alpha, at, lookup, normal) +
            fieldTap(vec3(0.0, 1.0, 0.0), base, alpha, at, lookup, normal) +
            fieldTap(vec3(1.0, 1.0, 0.0), base, alpha, at, lookup, normal) +
            fieldTap(vec3(0.0, 0.0, 1.0), base, alpha, at, lookup, normal) +
            fieldTap(vec3(1.0, 0.0, 1.0), base, alpha, at, lookup, normal) +
            fieldTap(vec3(0.0, 1.0, 1.0), base, alpha, at, lookup, normal) +
            fieldTap(vec3(1.0, 1.0, 1.0), base, alpha, at, lookup, normal);
        if (total.a <= 1e-6) return vec3(0.0);

        // No exposure here, and that is the opposite of what an analytic
        // light needs. A light states its brightness in the world's units and
        // has to be exposed like anything photographed. A probe holds what
        // was *already photographed* — it was filled from the picture the
        // scene drew, which Filament had already pre-exposed. Exposing it
        // again applies the camera twice, which at a daylight exposure is a
        // factor of about four hundred and reads as the field doing nothing.
        return total.rgb / total.a * materialParams.fieldSpacing.w;
    }

    // What the field gives the diffuse half, reflected by this surface —
    // which is the reason this is worth doing in the material rather than
    // over the finished picture: indirect light is light, and a red wall
    // reflects it red.
    vec3 fieldLight(vec3 albedo) {
        if (materialParams.fieldOrigin.w <= 0.0) return vec3(0.0);
        return fieldArriving(getWorldNormalVector()) * albedo;
    }

    // The environment's half of the specular integral, without an
    // environment to integrate.
    //
    // The split-sum approximation separates a specular reflection into the
    // light arriving and a term that depends only on roughness and viewing
    // angle. Filament keeps the second half as a lookup table, but a user
    // material cannot reach it, so this is the analytic fit that stands in
    // for it — accurate to well under a per cent across the range and four
    // instructions rather than a texture read.
    //
    // Karis, "Physically Based Shading on Mobile" (2014), after Lazarov.
    vec3 envBRDF(vec3 f0, float roughness, float nDotV) {
        const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);
        const vec4 c1 = vec4(1.0, 0.0425, 1.04, -0.04);
        vec4 r = roughness * c0 + c1;
        float a004 = min(r.x * r.x, exp2(-9.28 * nDotV)) * r.x + r.y;
        vec2 ab = vec2(-1.04, 1.04) * a004 + r.zw;
        return f0 * ab.x + ab.y;
    }

    // What the field gives the specular half.
    //
    // Without this a metal takes nothing at all from the field: its diffuse
    // is zero by definition, so a chrome ball in a room lit entirely by
    // bounced light was lit by nothing. It now reflects that room.
    //
    // Only rough surfaces, and the fade is not timidity. A probe keeps its
    // light in an octahedron six texels across, which is a believable blurred
    // reflection and nothing sharper — asking it for a mirror gives six
    // texels of blocky nonsense. Below the fade the surface is polished
    // enough that the environment map and the reflection probes, which have
    // real mip chains, are the right places to ask instead.
    vec3 fieldSpecular(vec3 f0, float roughness) {
        if (materialParams.fieldOrigin.w <= 0.0) return vec3(0.0);

        float rough = smoothstep(0.35, 0.7, roughness);
        if (rough <= 0.0) return vec3(0.0);

        vec3 n = getWorldNormalVector();
        vec3 v = getWorldViewVector();
        vec3 arriving = fieldArriving(reflect(-v, n));

        return arriving * envBRDF(f0, roughness, clamp(dot(n, v), 0.0, 1.0))
             * rough;
    }

    void material(inout MaterialInputs material) {
        vec2 uv = getUV0() * materialParams.uvTransform.xy
                + materialParams.uvTransform.zw;

        vec2 blendUv = getUV0() * materialParams.blendUvTransform.xy
                     + materialParams.blendUvTransform.zw;

        // How much of the second surface is showing, worked out before the
        // normal because the normal is blended too and has to be right
        // before prepareMaterial reads it.
        float layer = 0.0;
        if (materialParams.blendMode > 0) {
            float amount = clamp(materialParams.blendAmount, 0.0, 1.0);
            if (materialParams.blendMode == 1) {
                // Linear. The whole surface, evenly — a wash of one material
                // over another, and the one to reach for when the mix is a
                // property of the object rather than of the place on it.
                layer = amount;
            } else {
                float mask = materialParams.hasBlendMaskMap
                    ? texture(materialParams_blendMaskMap, uv).r
                    : 1.0;
                if (materialParams.blendMode == 2) {
                    // Masked. The mask says where, the amount says how much.
                    layer = clamp(mask * amount, 0.0, 1.0);
                } else {
                    // Masked depth, which is height blending.
                    //
                    // The difference is worth stating because it is the whole
                    // reason this mode exists. A masked blend fades one
                    // surface into the other, so at fifty per cent every
                    // cobble is half grass and the ground looks fogged. Read
                    // as a height instead, the mask decides *which* surface
                    // wins at each point — so grass fills the mortar between
                    // the cobbles first and the stones stay stone until they
                    // are buried. Sharpness is how quickly that happens: high
                    // is a hard edge following the relief, low is nearly the
                    // masked blend again.
                    float sharp = max(materialParams.blendSharpness, 0.0001);
                    layer = clamp((mask - (1.0 - amount)) * sharp + 0.5,
                                  0.0, 1.0);
                }
            }
        }

        // The normal has to be in before prepareMaterial builds the shading
        // frame from it. Setting it afterwards is silently ignored.
        if (materialParams.hasNormalMap) {
            vec3 packed = texture(materialParams_normalMap, uv).xyz;
            material.normal = packed * 2.0 - 1.0;
            // Where the second layer covers, the first layer's relief goes
            // with it: grass grown over cobbles does not show the cobbles
            // bumping through it. This is why the layer is worked out above
            // rather than down with the colour — the shading frame is built
            // from this normal a few lines further on, and a normal set
            // after that is quietly ignored.
            material.normal.xy *= materialParams.normalScale * (1.0 - layer);
        }

        prepareMaterial(material);

        vec4 base = materialParams.baseColor;
        if (materialParams.hasBaseColorMap) {
            base *= texture(materialParams_baseColorMap, uv);
        }
        if (layer > 0.0 && materialParams.hasBlendBaseColorMap) {
            vec4 over = materialParams.baseColor
                      * texture(materialParams_blendBaseColorMap, blendUv);
            base = mix(base, over, layer);
        }
        material.baseColor = base;

        float metallic  = materialParams.metallic;
        float roughness = materialParams.roughness;
        if (materialParams.hasMetallicRoughnessMap) {
            // glTF's packing, which is also what every exporter writes:
            // occlusion in red, roughness in green, metalness in blue.
            vec3 packed = texture(materialParams_metallicRoughnessMap, uv).rgb;
            roughness *= packed.g;
            metallic  *= packed.b;
        }
        material.metallic    = metallic;
        material.roughness   = roughness;
        material.reflectance = materialParams.reflectance;

        // The three extra lobes. Every one is nought by default and costs
        // nothing when it is: Filament compiles the coat, the grain and the
        // sheen into the shader unconditionally, but each multiplies out to
        // zero, so a surface that asked for none is shaded as though none
        // existed.
        material.clearCoat = materialParams.clearCoat;
        material.clearCoatRoughness = materialParams.clearCoatRoughness;
        material.anisotropy = materialParams.anisotropy;
        material.sheenColor = materialParams.sheenColor;
        material.sheenRoughness = materialParams.sheenRoughness;

        float occlusion = materialParams.ambientOcclusion;
        if (materialParams.hasOcclusionMap) {
            occlusion *= texture(materialParams_occlusionMap, uv).r;
        }
        material.ambientOcclusion = occlusion;

        vec3 emissive = materialParams.emissive * materialParams.emissiveIntensity;
        if (materialParams.hasEmissiveMap) {
            emissive *= texture(materialParams_emissiveMap, uv).rgb;
        }
        // The alpha is not opacity: it says whether the camera's exposure
        // applies. One means the glow dims when the shot is stopped down,
        // which is what makes an emissive surface sit in the scene rather
        // than float on top of it.
        material.emissive = vec4(emissive, 1.0);

        // Last, because it reads the finished surface: the base colour after
        // both maps and the second layer, the roughness after its map and
        // the normal after its. Added rather than mixed — see
        // `postLightingBlending` above — so both light a surface alongside
        // Filament's own lights instead of replacing what they did.
        //
        // Both, summed. Taking one of these is the resolution that would
        // have compiled, run, drawn a complete frame and quietly lost a
        // whole feature.
        // The dielectric floor again: 4% off any smooth surface, and a metal
        // reflecting its own colour instead. The same f0 the area lights use,
        // because it is the same surface.
        vec3 f0 = mix(vec3(0.04), base.rgb, metallic);

        material.postLightingColor = vec4(
            areaLighting(material, metallic, roughness)
                + fieldLight(base.rgb * (1.0 - metallic))
                + fieldSpecular(f0, roughness),
            0.0);
    }
}
