// One mesh, drawn many thousands of times in a single submission.
//
// Filament draws sixty-four copies at a time. That is the size of the block
// of per-renderable uniforms it indexes by the copy's own number, and asking
// for more does not fail — it reads past the end of that block and draws
// whatever was after it, which is a screen full of wedges.
//
// So a population is submitted in sixty-fours, and the transforms come from a
// texture rather than from anything per-draw: four texels a member, three rows
// of an affine and a colour. The book is one texture for the whole population,
// uploaded once and left alone, and each draw says where in it to start. There
// is no per-member cost on the processor at all.
material {
    name : orbisInstanced,
    shadingModel : lit,
    parameters : [
        { type : sampler2d, name : book, precision : high, format : float },
        // Which member of the population this renderable's first copy is.
        // Filament hands each copy an index counted from its own draw, and
        // the book is kept for the whole population rather than per draw.
        { type : int, name : base },

        // How far a member is still drawn from, and how far out it starts
        // going. Zero draws every one of them at full size.
        //
        // A member is not switched off at the edge, it sinks. Switching them
        // off in groups is what makes a field look like scattered debris:
        // sixty-four go at once, leaving a clump-shaped hole, and the boundary
        // is a line anybody can see. Shrinking each one on its own has no line
        // in it at all.
        { type : float, name : range },
        { type : float, name : fadeFrom },

        // How a member goes when it passes the range, matching OrbisFade.
        //
        //   0 sink   hold the bottom, draw the rest down to it. For anything
        //            planted, whose bottom is the ground it stands on.
        //   1 shrink draw it in towards its own centre. For scattered things
        //            that are not resting on anything.
        //   2 none   leave it alone and let the draw be culled at the range.
        //            For a continuous surface: there is no shape one member
        //            can take on its way out that does not tear a solid
        //            world, so it is fog that hides the boundary instead.
        { type : int, name : fadeMode },

        // Where the camera is, in world coordinates, handed in rather than
        // worked out. Filament renders camera-relative and the obvious way to
        // recover the origin is to subtract the incoming vertex from the
        // incoming world position — but the world position a copy is handed
        // is built from a block of per-copy uniforms indexed by
        // `instance_index`, and a copy whose slot in that block was never
        // written reads whatever the last renderable left there. Which put
        // cubes in the sky, and moved them when the camera turned, because
        // the order draws are submitted in is what decided the leftovers.
        // Taking the number directly is not a workaround; it is the only
        // input here that does not depend on state this material does not
        // own.
        { type : float3, name : cameraAt }
    ],
    variables : [ tint ],
    culling : back
}

vertex {
    // How wide a cell is, in world units. Sixteen, as in every block game
    // that has ever had a draw distance.
    #define kCellSide 16.0

    // The book is two thousand wide and as tall as it needs to be, so any
    // number of instances fits inside what a texture is allowed to be.
    vec4 page(int index) {
        return texelFetch(materialParams_book,
                          ivec2(index % 2048, index / 2048), 0);
    }

    void materialVertex(inout MaterialVertexInputs material) {
        int at = (materialParams.base + instance_index) * 4;
        vec4 r0 = page(at);
        vec4 r1 = page(at + 1);
        vec4 r2 = page(at + 2);

        // Rows, so the translation is the w of each and the rotation and
        // scale are the rest. Built into columns here, which is what a mat3
        // constructor takes.
        mat3 basis = mat3(vec3(r0.x, r1.x, r2.x),
                          vec3(r0.y, r1.y, r2.y),
                          vec3(r0.z, r1.z, r2.z));
        vec3 offset = vec3(r0.w, r1.w, r2.w);

        // Moved by the difference rather than set outright.
        //
        // Filament renders camera-relative: what is in worldPosition is the
        // point measured from wherever the camera is, not from the world's
        // origin. Assigning an absolute position into it puts everything an
        // entire camera-position away from where it belongs — which, from
        // inside, looks like the screen going black. A delta is the same
        // whichever origin it is measured from.
        vec3 local = getPosition().xyz;

        // Measured flat, ignoring height, and that is the whole trick.
        //
        // A straight distance makes a member's fate depend on how high it
        // stands: a canopy fifteen blocks up is further from the camera than
        // the ground under it, so it crosses the range first and the tree
        // goes while the hill stays — or the reverse, and a lid of leaves
        // hangs over nothing. Measured flat, a whole column shares one
        // answer, so a world can only ever lose complete columns from its
        // edge. It is what a block game has always done.
        // Measured from the *cell* a member stands in, not from the member.
        //
        // Sixteen blocks square, flat, which is the grain a block game has
        // always culled at. Per member the boundary cuts through whatever
        // straddles it: a canopy reaches two blocks past its trunk, so the
        // trunk falls outside the range while a leaf falls inside, and what
        // is left is a lid of leaves hanging over nothing. Judged by cell,
        // every block standing in the same square shares one verdict, so the
        // world can only lose whole sections and a tree always leaves with
        // the ground it grew on.
        vec2 cell = (floor(offset.xz / kCellSide) + 0.5) * kCellSide;
        float away = length(cell - materialParams.cameraAt.xz);

        // How much of this member is left at that distance.
        float standing = 1.0;
        if (materialParams.range > 0.0 && materialParams.fadeMode != 2) {
            standing = 1.0 - smoothstep(materialParams.fadeFrom,
                                        materialParams.range, away);
        }

        // The mesh runs from minus one to one, so holding the bottom edge and
        // drawing the rest down to it takes a planted member into the ground.
        // That is only true of a member that was standing on the ground —
        // stacked members go in towards their own centre instead, or a cube
        // resting on another cube flattens into a plate and stays in the air.
        // With standing at one, sunk is local, so `none` needs no case here.
        vec3 sunk = vec3(local.x, -1.0 + (local.y + 1.0) * standing, local.z);
        vec3 standingLocal =
            materialParams.fadeMode == 1 ? local * standing : sunk;

        // Camera-relative, because that is the space Filament works in.
        material.worldPosition.xyz =
            basis * standingLocal + offset - materialParams.cameraAt;

        // The normal has to be turned with it, or every instance is lit as
        // though it were facing the way the mesh was modelled. Right for a
        // rotation with the scale along its own axes, which is what a
        // population of boxes and trees has.
        material.worldNormal = normalize(basis * material.worldNormal);

        material.tint = page(at + 3);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(variable_tint.rgb, 1.0);
        material.roughness = 0.8;
        material.metallic = 0.0;
        material.reflectance = 0.35;
    }
}
