// Cloud, seen from underneath.
//
// Drawn on a dome around the camera, but the cloud itself is not on the dome:
// every pixel works out where its own view ray crosses a flat layer at the
// cloud's altitude and samples the weather there. That is what makes it read
// as sky rather than as a painted ceiling — clouds are overhead when you look
// up and crowd together at the horizon, because that is what a layer of cloud
// a hundred metres up actually does.
//
// A dome with a picture on it cannot do that: it has no altitude, so it looks
// the same in every direction and reads as wallpaper the moment the camera
// turns.
material {
    name : orbisClouds,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    // The camera is inside it.
    culling : none,
    parameters : [
        { type : float3, name : colour },
        // How much of the sky is covered, from nothing to everything.
        { type : float,  name : cover },
        { type : float,  name : time },
        { type : float2, name : wind },
        // Turns of the noise per metre: one over how big a cloud is.
        { type : float,  name : scale },
        // How high the layer is, in metres.
        { type : float,  name : altitude },
        { type : float3, name : eye }
    ],
}

fragment {
    float hash(vec2 cell) {
        return fract(sin(dot(cell, vec2(127.1, 311.7))) * 43758.5453123);
    }

    float valueNoise(vec2 p) {
        vec2 cell = floor(p);
        vec2 f = fract(p);
        vec2 w = f * f * (3.0 - 2.0 * f);

        float a = hash(cell);
        float b = hash(cell + vec2(1.0, 0.0));
        float c = hash(cell + vec2(0.0, 1.0));
        float d = hash(cell + vec2(1.0, 1.0));

        return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);
    }

    // Five octaves. Cloud is looked at for longer than mist is, and the extra
    // one is what stops the edges reading as blobs.
    float clouds(vec2 p) {
        float total = 0.0;
        float amplitude = 0.5;
        vec2 q = p;

        for (int octave = 0; octave < 5; octave++) {
            total += amplitude * valueNoise(q);
            q = q * 2.07 + 3.1;
            amplitude *= 0.5;
        }
        return total;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec3 direction = normalize(getWorldPosition() - materialParams.eye);
        float up = direction.y;

        // Below the horizon there is no sky to put cloud in.
        if (up <= 0.005) {
            material.baseColor = vec4(0.0);
            return;
        }

        // Where this ray crosses the layer. Far away near the horizon and
        // directly overhead when looking up, which is the whole perspective.
        float distance = materialParams.altitude / up;
        vec2 place = materialParams.eye.xz + direction.xz * distance;

        // The wind moves the weather, not the sky.
        place -= materialParams.wind * materialParams.time;

        float n = clouds(place * materialParams.scale);

        // Cover decides how much of the field counts as cloud: a broken sky
        // at one end and a closed one at the other.
        float threshold = mix(0.72, 0.30, clamp(materialParams.cover, 0.0, 1.0));
        float cloud = smoothstep(threshold, threshold + 0.22, n);

        // Two fades. One takes the cloud out at the horizon, where the ray is
        // so flat that a single cloud would smear across the whole sky. The
        // other thins it far away, which is what haze does to anything.
        float horizon = smoothstep(0.02, 0.22, up);
        float far = 1.0 - smoothstep(4000.0, 14000.0, distance);

        float alpha = clamp(cloud * horizon * far, 0.0, 1.0);

        // Cloud has a depth to it. What is thick is darker underneath, and
        // what is thinning out at the edge is where the light comes through —
        // which is most of what makes a sky read as cloud rather than as a
        // grey sheet somebody has pulled across it.
        float thickness = smoothstep(threshold, threshold + 0.35, n);
        vec3 tint = materialParams.colour * mix(1.35, 0.72, thickness);

        material.baseColor = vec4(tint * alpha, alpha);
    }
}
